# ── Site ────────────────────────────────────────────────────────────────────
# Server-only: no NEXT_PUBLIC_ prefix, so it is never inlined into the browser
# bundle. On Vercel this can be left unset — VERCEL_PROJECT_PRODUCTION_URL is
# used automatically. Set it once you have a custom domain.
SITE_URL=""

# ── AI agent (required for /api/chat, /api/match, /api/explain) ─────────────
OPENAI_API_KEY="sk-..."
# Hard ceiling on model spend per calendar day, in USD, enforced in Redis.
# When it is reached the agent serves a canned reply and makes no API call.
AI_DAILY_BUDGET_USD="2"

# ── Rate limiting (Upstash Redis, free tier) ────────────────────────────────
# Without these the AI routes refuse to run in production. See lib/rate-limit.ts.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Contact form (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=""
CONTACT_EMAIL=""
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# ── GitHub live signals (optional; unauthenticated works but is rate limited) ─
GITHUB_TOKEN=""
