{
  "name": "ngwkhai-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Agentic research folio \u2014 Nguyen Dinh Khai",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "velite --watch & next dev",
    "prebuild": "velite --clean && tsx scripts/build-knowledge.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "knowledge": "tsx scripts/build-knowledge.ts",
    "covers": "node scripts/build-covers.mjs",
    "test:a11y": "playwright test e2e/a11y.spec.ts --project=desktop",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:contrast && pnpm test",
    "shots": "CAPTURE=1 playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.51",
    "@ai-sdk/react": "4.0.87",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.3",
    "ai": "7.0.84",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "1.37.0",
    "motion": "13.1.1",
    "next": "16.3.3",
    "next-intl": "4.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "resend": "6.25.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "velite": "0.4.0",
    "vitest": "4.1.11"
  }
}
